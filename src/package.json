{
  "name": "graph-drawing-libraries",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run runsuite && vite",
    "build": "npm run runsuite && vite build",
    "preview": "vite preview",
    "runsuite": "vite build --config vite.runsuite.config.js",
    "stats": "node scripts/fetch-stats.js",
    "screenshots": "npm run runsuite && node scripts/screenshots.js",
    "measure": "npm run runsuite && node scripts/measure.js",
    "test": "node --test"
  },
  "dependencies": {
    "ngraph.generators": "^21.0.0",
    "ngraph.graph": "^20.1.2"
  },
  "devDependencies": {
    "puppeteer-core": "^25.18.1",
    "vite": "^8.3.8"
  }
}
